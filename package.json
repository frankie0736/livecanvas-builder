{
	"name": "lc_builder",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"migration:snapshot": "bun run scripts/migration/snapshot.ts",
		"migration:import-local": "bun run scripts/migration/import-local.ts",
		"migration:verify-local": "bun run scripts/migration/verify-local.ts",
		"migration:archive-media": "node --no-warnings --experimental-strip-types scripts/migration/media.ts archive",
		"migration:import-media-local": "node --no-warnings --experimental-strip-types scripts/migration/media.ts import-local",
		"migration:verify-media-local": "node --no-warnings --experimental-strip-types scripts/migration/media.ts verify-local",
		"test:task-e2e:local": "bun test src/server/tasks/__tests__/local-e2e.test.ts",
		"cf:dry-run": "wrangler deploy --dry-run",
		"cf-typegen": "wrangler types",
		"dev": "vite dev",
		"preview": "vite preview",
		"start": "vite dev",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
		"prepare": "husky"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^1.2.1",
		"@ai-sdk/deepseek": "^0.2.0",
		"@ai-sdk/openai": "^1.3.0",
		"@ai-sdk/openai-compatible": "^0.2.0",
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@hookform/resolvers": "^4.1.3",
		"@openrouter/ai-sdk-provider": "^0.4.3",
		"@radix-ui/react-alert-dialog": "^1.1.6",
		"@radix-ui/react-avatar": "^1.1.3",
		"@radix-ui/react-checkbox": "^1.1.4",
		"@radix-ui/react-dialog": "^1.1.6",
		"@radix-ui/react-dropdown-menu": "^2.1.6",
		"@radix-ui/react-label": "^2.1.2",
		"@radix-ui/react-progress": "^1.1.2",
		"@radix-ui/react-select": "^2.1.6",
		"@radix-ui/react-slot": "^1.2.0",
		"@radix-ui/react-switch": "^1.1.3",
		"@radix-ui/react-tabs": "^1.1.3",
		"@radix-ui/react-tooltip": "^1.1.8",
		"@t3-oss/env-nextjs": "^0.12.0",
		"@tanstack/react-router": "^1.170.17",
		"@tanstack/react-start": "^1.168.27",
		"@trigger.dev/sdk": "^3.3.17",
		"@vercel/blob": "^0.27.3",
		"@vercel/edge-config": "^1.4.0",
		"ai": "^4.2.0",
		"babel-plugin-react-compiler": "^19.0.0-beta-3229e95-20250315",
		"better-auth": "^1.6.23",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.41.0",
		"framer-motion": "^12.6.0",
		"html-to-image": "^1.11.13",
		"lucide-react": "^0.483.0",
		"next": "15.3.0-canary.21",
		"next-themes": "^0.4.6",
		"postgres": "^3.4.4",
		"qwen-ai-provider": "^0.1.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-error-boundary": "^5.0.0",
		"react-hook-form": "^7.54.2",
		"sonner": "^2.0.1",
		"tailwind-merge": "^3.0.2",
		"zod": "^3.24.2",
		"zustand": "^5.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@cloudflare/vite-plugin": "^1.29.0",
		"@cloudflare/workers-types": "^4.20250710.0",
		"@tailwindcss/postcss": "^4.0.15",
		"@trigger.dev/build": "^3.3.17",
		"@types/bun": "^1.2.5",
		"@types/node": "^20.14.10",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^6.0.1",
